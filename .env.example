# Copy to .env and fill in. Never commit .env.
GOOGLE_API_KEY=            # Gemini, free tier, from Google AI Studio
GROQ_API_KEY=              # fallback model, free tier
OLLAMA_API_BASE=http://localhost:11434
OPENAI_API_KEY=            # optional, off by default

ATLAS_PRIMARY_MODEL=gemini/gemini-2.5-flash   # check AI Studio for current free-tier models
ATLAS_FALLBACK_MODELS=groq/llama-3.3-70b-versatile,ollama_chat/llama3.1

GOOGLE_OAUTH_CLIENT_FILE=secrets/credentials.json
GOOGLE_TOKEN_FILE=secrets/token.json
ATLAS_ALLOWED_RECIPIENT_DOMAIN=            # your demo account's domain only
